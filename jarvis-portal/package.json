{
  "name": "jarvis-portal",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "JARVIS online progression and session portal",
  "scripts": {
    "test": "node --test",
    "check": "node --check src/server/index.js && node --check public/app.js",
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:local": "wrangler d1 migrations apply jarvis-portal-db --local",
    "db:remote": "wrangler d1 migrations apply jarvis-portal-db --remote"
  },
  "devDependencies": {
    "wrangler": "^4.0.0"
  },
  "engines": {
    "node": ">=22"
  }
}
